---
import Layout from '@/layouts/Layout.astro'
import { ExplorePage } from '@/components/Explore/Explore'
import {
  getMovieGenres,
  getTrending,
  getTvShowGenres,
  multiSearch,
} from '@/utils/tmdb'

const query = Astro.url.searchParams.get('q') ?? ''

const [searchData, trendingResults, movieGenres, tvShowGenres] =
  await Promise.all([
    query ? multiSearch(query) : null,
    getTrending('all'),
    getMovieGenres(),
    getTvShowGenres(),
  ])

const uniqueGenres = Array.from(
  new Map(
    [...movieGenres.genres, ...tvShowGenres.genres].map(genre => [
      genre.name,
      genre,
    ])
  ).values()
).sort((a, b) => a.name.localeCompare(b.name))

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=86400, stale-while-revalidate=86400'
)
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'max-age=86400')
---

<Layout
  title='Wovie - Watch Movies & TV Shows Free'
  description='Discover new movies and tv shows'
  image='https://wovix.app/og.png'
>
  <div class='relative min-h-[calc(100svh-var(--navbar-height))]'>
    <div
      class='pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-hero-vignette'
    >
    </div>
    <div
      class='pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/20 to-transparent'
    >
    </div>

    <div class='relative px-4 py-8 sm:px-8 sm:py-10 lg:px-10 lg:py-12'>
      <ExplorePage
        client:idle
        query={query}
        trending={trendingResults.results}
        searchData={searchData?.results}
        genres={uniqueGenres}
      />
    </div>
  </div>
</Layout>
