---
import { formatDate, getImagePath } from '@/utils'
import { Image } from 'astro:assets'
import type { Cast, Genre } from 'tmdb-ts'
import { WatchlistButton } from './WatchlistButton'

interface Props {
  cast: Cast[]
  genres: Genre[]
  image: string | undefined
  overview: string
  rating: number
  releaseDate: string
  title: string
  mediaType: 'movie' | 'tv'
  id: number
}

const {
  cast,
  genres,
  image,
  overview,
  rating,
  releaseDate,
  title,
  mediaType,
  id,
} = Astro.props
---

<section
  class='rounded-2xl border border-border-subtle bg-surface-overlay/60 p-5 backdrop-blur-sm sm:p-6'
  id='info'
>
  <div class='flex flex-col gap-6 md:flex-row'>
    {
      image && (
        <div class='mx-auto aspect-[2/3] w-36 flex-shrink-0 overflow-hidden rounded-xl ring-1 ring-border-subtle md:mx-0 md:w-44'>
          <Image
            src={getImagePath(image, 'w342')}
            width='342'
            height='513'
            alt={title}
            class='h-full w-full object-cover'
          />
        </div>
      )
    }
    <div class='min-w-0 flex-1 space-y-4'>
      <div class='flex items-start justify-between gap-4'>
        <div>
          <h2 class='text-xl font-bold tracking-tight text-white sm:text-2xl'>
            {title}
          </h2>
          <div
            class='mt-2 flex flex-wrap items-center gap-3 text-sm text-zinc-500'
          >
            <span class='font-medium text-accent'>{rating.toFixed(1)} ★</span>
            <span>{formatDate(releaseDate)}</span>
            <span class='capitalize'>{mediaType}</span>
          </div>
        </div>
        <WatchlistButton
          client:visible
          media={{
            id,
            mediaType,
            title,
            poster_path: image ?? '',
            backdrop_path: image ?? '',
            vote_average: rating,
            release_date: releaseDate,
            name: title,
            first_air_date: releaseDate,
            original_language: 'en',
          }}
        />
      </div>

      <div class='flex flex-wrap gap-1.5'>
        {
          genres.map(genre => (
            <span class='rounded-md bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent'>
              {genre.name}
            </span>
          ))
        }
      </div>

      <p class='text-sm leading-relaxed text-zinc-400'>{overview}</p>

      {
        cast.length > 0 && (
          <div>
            <p class='mb-2 text-xs font-medium uppercase tracking-wider text-zinc-500'>
              Cast
            </p>
            <div class='flex gap-2 overflow-x-auto pb-1 scrollbar-hide'>
              {cast.slice(0, 12).map(person => (
                <div
                  title={person.name}
                  class='size-10 flex-shrink-0 overflow-hidden rounded-full bg-surface-raised ring-1 ring-border-subtle'
                >
                  {person.profile_path && (
                    <Image
                      src={getImagePath(person.profile_path, 'w45')}
                      width='45'
                      height='45'
                      loading='lazy'
                      alt={person.name}
                      class='h-full w-full object-cover'
                    />
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
